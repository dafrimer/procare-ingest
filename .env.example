# Procare Authentication - provide token OR email+password
PROCARE_AUTH_TOKEN=
PROCARE_EMAIL=
PROCARE_PASSWORD=
PROCARE_SITE_URL=https://api-school.procareconnect.com
PROCARE_SITE_ID=
PROCARE_AUTH_URL=https://online-auth.procareconnect.com/sessions/

# procare-api wiring (sync calls api over HTTP)
API_URL=http://procare-api:8080
INGEST_TOKEN=                       # must match the value set on procare-api

# Sync Settings
SYNC_INTERVAL_MINUTES=15
ACTIVITY_LOOKBACK_DAYS=30
RUN_ONCE=false
PAGE_SIZE=100
TOKEN_CACHE_PATH=/data/.token_cache.json

# --- procare-api only ---
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
SQLITE_PATH=/data/procare.db
CORS_ORIGINS=*

# Notifications (api side)
NOTIFY_BACKEND=log                  # log | webhook | smtp | apprise (comma-list ok)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_FORMAT=generic       # generic | discord | slack | ntfy
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=true
APPRISE_URLS=

# Alert dedup + heartbeat
ALERT_COOLDOWN_MINUTES=60
HEARTBEAT_ENABLED=true
HEARTBEAT_CHECK_SECONDS=300
HEARTBEAT_STALE_MINUTES=30
HEARTBEAT_ENTITIES=kids,rooms,daily_activities