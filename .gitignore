# Ignore all dotfiles/dotfolders by default (keep .github, .gitignore, .env.example via negation below)
.*
!/.github/
!/.gitignore
!/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual envs
.venv
venv/
ENV/

# Local secrets / runtime data
.env
.token_cache.json

# Logs / OS
*.log
.DS_Store

# Session/agent artifacts that should never be committed
plan.md
CLAUDE.md
AGENTS.md
claude.md
